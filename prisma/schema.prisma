// GitPrism data model.
// Mirrors Git's own object model so the lab can persist real, Git-compatible
// objects: content-addressed blobs, trees and commits, plus movable refs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ObjectType {
  BLOB
  TREE
  COMMIT
}

/// A learner's sandbox repository in the lab.
model Workspace {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  objects   GitObject[]
  refs      Ref[]
  head      String      @default("refs/heads/main")
}

/// One Git object. `oid` is the SHA-1 of "<type> <size>\0<content>",
/// so identical content in a workspace is stored exactly once.
model GitObject {
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oid         String     @db.Char(40)
  type        ObjectType
  size        Int
  content     Bytes
  createdAt   DateTime   @default(now())

  @@id([workspaceId, oid])
  @@index([workspaceId, type])
}

/// A named pointer to a commit, e.g. refs/heads/main.
model Ref {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  target      String    @db.Char(40)
  updatedAt   DateTime  @updatedAt

  @@id([workspaceId, name])
}
