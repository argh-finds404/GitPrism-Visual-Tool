# Postgres for saved projects and the lab's server-side persistence.
# Optional: without it, GitPrism still runs. A picked folder is read and analysed entirely in
# the browser; only "Save and get a link" needs a database, and it reports 503 without one.
# Local:      postgresql://USER:PASSWORD@localhost:5432/gitprism
# Hosted:     any Postgres connection string (Neon, Supabase, Prisma Postgres, Vercel Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gitprism"
